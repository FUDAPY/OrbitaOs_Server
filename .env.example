# OrbitaOs - variables de entorno
#   cp .env.example .env    (una sola vez, despues editar los valores)
# En Dokploy: se pega en la pestana "Environment" del servicio.
# Este archivo NUNCA se versiona (esta en .gitignore).

# --- Entorno ----------------------------------------------------------------
NODE_ENV=production
TZ=America/Asuncion
# Zona horaria usada para interpretar fechas sin zona explicita.
# Cada usuario puede tener la suya (campo "timezone" del modelo User).

# --- MongoDB ----------------------------------------------------------------
# Dentro de Docker Compose el host es el nombre del servicio: "mongo".
# En un servidor con MongoDB externo, poner la IP/host real.
MONGO_URI=mongodb://mongo:27017/orbitaos
MONGO_MAX_POOL_SIZE=10

# --- Space Bunny Alpha (IA) -------------------------------------------------
# Endpoint oficial compatible con OpenAI (mismo esquema que OpenRouter).
# La clave es del formato sb_live_... y se obtiene en la pagina de la API.
#
# Si la API KEY queda vacia, OrbitaOs arranca en MODO MOCK: el enrutador
# usa reglas locales para detectar la intencion y el sistema sigue operativo.
SPACE_BUNNY_API_URL=https://spacebunnymodel.com/api/v1/chat/completions
SPACE_BUNNY_API_KEY=
SPACE_BUNNY_MODEL=space-bunny-alpha
SPACE_BUNNY_TEMPERATURE=0.2
# Space Bunny Alpha es un modelo de razonamiento: gasta tokens pensando antes
# de responder. Un max_tokens bajo lo corta a mitad del razonamiento.
SPACE_BUNNY_MAX_TOKENS=4096
SPACE_BUNNY_TIMEOUT_MS=60000
# Ultimos mensajes de la conversacion que se envían como contexto.
AI_CONTEXT_MESSAGES=8
# Tope diario de llamadas a la IA. Al alcanzarlo el bot responde con las
# reglas locales (modo mock) en vez de llamar a Space Bunny.
# 0 = sin limite. Ej: 200 para un uso moderado.
SPACE_BUNNY_DAILY_CAP=0

# --- Reintentos ante fallos del proveedor -------------------------------
# Space Bunny a veces contesta "Upstream error: Provider returned an empty
# response": es un fallo momentaneo suyo y un segundo despues responde bien.
# Con reintentos el bot se recupera solo en vez de degradar a respuestas
# basicas. Solo se reintenta lo transitorio (timeouts, 429, 5xx y ese 400);
# una clave invalida (401) no se reintenta nunca.
# Numero de intentos en total, incluido el primero. Maximo 6.
AI_RETRY_INTENTOS=3
# Espera entre intentos: empieza en AI_RETRY_BASE_MS y se duplica hasta el tope.
AI_RETRY_BASE_MS=800
AI_RETRY_MAX_MS=8000
# Circuito de proteccion: si el proveedor acumula estos fallos seguidos, se
#olian las llamadas durante AI_CIRCUITO_MS y todos reciben la respuesta basica
# sin esperar.Pasada la ventana se prueba si el proveedor revivio.
AI_CIRCUITO_FALLOS=4
AI_CIRCUITO_MS=60000

# --- Seguridad / usuarios -------------------------------------------------
# Primer usuario del sistema: se crea automaticamente en el primer arranque
# si la base de datos esta vacia. Es el unico que puede administer usuarios.
# Si se dejan vacios se usa el acceso inicial thesadboypy / 741963: cambiar
# la clave ni bien se entra al panel (modulo Usuarios).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# RESET_ADMIN_PASSWORD=1
ADMIN_NAME=
# Telefono del administrador: recibe advertencias del sistema.
ADMIN_PHONE=54911123456789
# Numeros autorizados a administrar la lista blanca desde WhatsApp.
# Coma separados. Quien figure aqui puede usar /agregar, /quitar y /contactos.
ADMIN_WHITELIST=

# Telefonos autorizados, separados por coma, formato internacional sin + ni
# espacios: 54911123456789,54911987654321
#
# Opcional: si queda vacio el servicio arranca igual. Los telefonos listados
# aqui se dan de alta como usuarios con acceso al bot. Para gestionarlos despues
# usar:  npm run user -- create <usuario> <clave> --phone <numero>
WHITELIST=

# --- Presentacion del bot ---------------------------------------------------
# Nombre con el que se presenta. Aparece en el saludo que recibe quien escribe
# sin estar autorizado. Ej: Administrador General Chicolin
BOT_NAME=
# Saludo para los NO autorizados. Es un texto fijo: no usa IA ni guarda el
# mensaje. Si queda vacio se usa el que menciona BOT_NAME.
AUTO_REPLY_MESSAGE=
# Cada cuanto se repite ese saludo al mismo numero, en horas. Evita insistir
# si la persona insiste.
AUTO_REPLY_HORAS=24

# --- Sesion de WhatsApp ----------------------------------------------------
# NUMERO del WhatsApp corporativo, con prefijo del pais y sin simbolos.
# Ejemplo Argentina: 54911123456789   |   Mexico: 5215512345678
#
# Es lo MAS IMPORTANTE para arrancar: si esta definido, el bot se empareja con
# un CODIGO de 8 caracteres (ideal en un servidor sin monitor). Si queda vacio,
# hay que escanear el QR que aparece en los logs.
BOT_PHONE=

# Carpeta donde whatsapp-web.js guarda la sesion (LocalAuth).
# Debe ser un volumen persistente o se pierde el vinculo al reiniciar.
SESSION_PATH=/app/session
# Ruta del perfil de Puppeteer/Chromium.
PUPPETEER_USER_DATA_DIR=/app/.wwebjs
# Margen (ms) para las llamadas al navegador. El default de Puppeteer son
# 3 minutos; si ves "Runtime.callFunctionOn timed out" en los logs, subilo.
PUPPETEER_PROTOCOL_TIMEOUT=300000
# Separar el perfil del bot del directorio de sesion.
WEBJS_CACHE_TYPE=local

# --- Recordatorios (cron) ---------------------------------------------------
# Expresion cron del motor de recordatorios (minuto hora dia mes diaSemana).
# Por defecto cada minuto: es la base para las ventanas de 24h y 2h.
CRON_REMINDERS=*/1 * * * *
CRON_TZ=America/Asuncion
# Ventana de tolerancia, en minutos, por lado del hito (24h / 2h).
# Evita perder un recordatorio si el contenedor se reinicia justo en ese minuto.
REMINDER_TOLERANCE_MINUTES=10
# Zona horaria usada para los textos de los recordatorios.
REMINDER_TIMEZONE=America/Asuncion

# --- Comportamiento ---------------------------------------------------------
# Prefijo para que el bot responda en los grupos. Vacio = solo privado.
GROUP_PREFIX=
# Log del contenido de los mensajes (util para depurar). true/false
LOG_MESSAGES=true

# --- Servidor HTTP (salud + panel) ------------------------------------------
# Responde /health (texto "ok"), / (panel web) y /api/* (JSON).
# Corre dentro del contenedor sin publicar puertos en el host: el proxy
# inverso llega por la red interna. Para consultarlo:
#   docker compose exec orbitaos wget -qO- http://127.0.0.1:3000/health
#
# El dominio se define en la pestana "Domains" de Dokploy, que genera las
# etiquetas del proxy y conecta el contenedor.
PORT=3000

# --- Busqueda web (DuckDuckGo, sin costo) ----------------------------------
# Permite que la IA consulte internet con la herramienta buscar_en_web.
# Poner en false la desactiva por completo.
# --- NexusOS (POS / ERP / CRM) ----------------------------------------------
# Integracion con el sistema de ventas para cargar y consultar stock desde
# WhatsApp ("cargar en stock Pilsen 1 LT 6 unidades").
#
# SEGURIDAD: NEXUS_SERVICE_TOKEN es un SECRETO. Va solo aca (o en la pestaña
# Environment de Dokploy). Nunca en el codigo, ni en un mensaje de commit.
#
# NEXUS_API_URL trae el prefijo de la API, no solo el host: el backend lo
# define en server/src/config/env.ts (API_PREFIX) y el cliente lo usa tal cual.
# NEXUS_API_URL=https://nexus.lingroupsapy.com/api/v1
NEXUS_API_URL=
NEXUS_SERVICE_TOKEN=
# Espera maxima de una llamada, en ms. Si se supera, el bot informa que NO pudo
# cargar en vez de quedarse colgado. Default: 10000.
NEXUS_TIMEOUT_MS=10000
# Sucursal por defecto para las cargas. Debe coincidir EXACTO con el valor de
# products.sucursal en NexusOS, incluidas las tildes. Vacio = la que resuelva
# el propio NexusOS.
NEXUS_SUCURSAL=
WEB_SEARCH_ENABLED=true
